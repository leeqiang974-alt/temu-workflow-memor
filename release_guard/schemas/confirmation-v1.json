{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temu Release Guard confirmation",
  "type": "object",
  "required": ["batch_id", "proposal_id", "proposal_sha256", "decision", "confirmer"],
  "properties": {
    "batch_id": {"type": "string"},
    "proposal_id": {"type": "string"},
    "proposal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"const": "CONFIRMED"},
    "confirmer": {"type": "string", "minLength": 1}
  }
}
