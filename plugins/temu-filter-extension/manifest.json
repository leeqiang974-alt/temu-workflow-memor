{
  "manifest_version": 3,
  "name": "Temu 价差筛选插件",
  "version": "1.7",
  "description": "在 Temu 卖家后台按申报价高于参考申报价筛选产品，并复制标题指纹匹配行",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Temu 价差筛选",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://agentseller.temu.com/*", "https://*.temu.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://agentseller.temu.com/*", "https://*.temu.com/*", "https://*.kwcdn.com/*", "https://*.pddpic.com/*", "http://127.0.0.1:8765/*"]
}
